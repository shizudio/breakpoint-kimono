# Copy to .env and fill in. `npm start` loads it with node --env-file.
# NEVER commit .env — it carries the RPC key, the session secret and the admin
# token. Nothing in this file is ever sent to the browser.

PORT=4321
# mainnet | devnet. Rehearse on devnet first: paying on the wrong network is the
# one failure that looks like success to the buyer.
NETWORK=mainnet

# Helius / QuickNode / Triton — anything that speaks Solana JSON-RPC.
# Carries an API key. Server-side only.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=REPLACE_ME

# Where the USDC lands.
TREASURY=DWDeu7snxGK9uscdJbtjcQ4oU9cCdpNZPaate6BVqEuD

PRICE_USDC=300
CAP=15
HOLD_MINUTES=20
PRESALE_ENDS=2026-09-29T12:00:00Z

# openssl rand -hex 32 — rotating this signs everyone out.
SESSION_SECRET=REPLACE_ME
SESSION_HOURS=72

# Who may open /admin. Solana addresses, comma-separated — one per person at
# the counter. They sign in with the same wallet signature buyers use, so there
# is no shared password to leak in a screenshot or a chat message, and removing
# someone is one edit here plus a restart.
ADMIN_WALLETS=REPLACE_ME

# Telegram: talk to @BotFather for the token, @userinfobot for your chat id.
# Leave blank to disable notifications; orders still record normally.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The buyer's confirmation email — piece number, pickup code and the QR, sent
# the moment a payment verifies. Leave RESEND_API_KEY blank and nothing is sent:
# orders still record and the pass is still in the panel behind the wallet.
#
# EMAIL_FROM must be on a domain you have verified with Resend (resend.com →
# Domains → add the DKIM/SPF records). An unverified from-address is rejected at
# the API and the buyer hears nothing, so run `npm run server:check` after
# setting this — it sends itself a test and tells you.
#
# It cannot be a gmail.com or other free-mail address: verification is a DNS
# record on the sending domain, and you cannot put one on gmail.com. Send from
# the domain and put the mailbox people should actually reach in EMAIL_REPLY_TO
# — that is the address a buyer's reply goes to, which is what they care about.
RESEND_API_KEY=
EMAIL_FROM=Shizudio <kimono@shizudio.me>
EMAIL_REPLY_TO=shizudio.eth@gmail.com
# An optional copy of every confirmation, to an address you control. Worth
# setting: it is the only record of what a buyer was actually sent.
EMAIL_BCC=

# The order card pictured in the confirmation email. Empty reads
# site/public/web/share-card.jpg next to this checkout, which is what you want
# unless the two apps are deployed apart.
EMAIL_CARD_IMAGE=

# Buyers' profile pictures. The X handle is appended to AVATAR_SOURCE and the
# result is fetched once, server-side, and kept — so visitors' browsers never
# ask a third party who bought a kimono, and the picture survives the source
# going away. Empty turns it off; the panel then shows initials, which is the
# design's own fallback. X's user lookup needs a paid API tier; unavatar does
# not, and `?fallback=false` (added by the code) makes a miss a 404 rather than
# a generic silhouette.
AVATAR_SOURCE=https://unavatar.io/x/
AVATAR_DIR=../data/avatars

DB_PATH=../data/orders.db

# The front end is its own app (`npm run start` at the repo root), so this is
# empty by default and the server runs the API and /admin only. Point it at
# ../dist to have one process serve the built site too — a single-origin
# deployment, which is the arrangement that needs no CORS and no SameSite=None.
SITE_DIR=../dist

# Origins allowed to call this API with credentials, comma-separated. Needed
# ONLY when the front end is served from a different origin (VITE_SERVER_URL
# set). Leave empty for same-origin. Setting this forces the session cookie to
# SameSite=None, so SECURE_COOKIES=1 becomes mandatory — the server refuses to
# start otherwise, because browsers drop such a cookie silently.
ALLOWED_ORIGINS=

# Public origin, used in pickup links and QR codes.
PUBLIC_ORIGIN=http://localhost:4321
# Set to 1 once you are behind HTTPS, so the session cookie is Secure.
SECURE_COOKIES=
