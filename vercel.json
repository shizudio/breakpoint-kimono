{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,

  "rewrites": [
    { "source": "/api/:path*", "destination": "http://34.124.147.154/api/:path*" },
    { "source": "/admin", "destination": "http://34.124.147.154/admin" },
    { "source": "/admin/:path*", "destination": "http://34.124.147.154/admin/:path*" },
    { "source": "/vendor/jsqr.js", "destination": "http://34.124.147.154/vendor/jsqr.js" }
  ],

  "headers": [
    {
      "source": "/frames-v2/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/web/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/build/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
