# Front end (Vite). Copy to .env — only VITE_* names reach the browser, so
# never put a secret here. The server's own secrets live in server/.env.

# Where the API is.
#
# Leave EMPTY to keep one origin: Vite proxies /api and /admin to the server in
# development, and you put a reverse proxy in front in production. The session
# cookie then stays SameSite=Lax and nothing needs CORS. This is the recommended
# setting.
#
# Set it to an absolute origin (https://api.example.com) to call the API
# directly, cross-origin. Then the server also needs ALLOWED_ORIGINS to name
# this app and SECURE_COOKIES=1, or sign-in will fail in a way that looks like
# nothing happened.
VITE_SERVER_URL=

# Where the dev proxy forwards to when VITE_SERVER_URL is empty.
DEV_API_URL=http://localhost:4321
